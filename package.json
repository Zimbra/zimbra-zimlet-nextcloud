{
  "private": true,
  "name": "zimbra-zimlet-nextcloud",
  "version": "1.2.3",
  "license": "Network Edition License",
  "description": "Nextcloud integration for Zimbra",
  "main": "build/index.js",
  "module": "src/index.js",
  "scripts": {
    "build": "zimlet build && cp .netlify/* build",
    "watch": "zimlet watch",
    "start": "zimlet watch",
    "package": "zimlet package --name $npm_package_name --description $npm_package_description --pkg-version $npm_package_version --zimbraXVersion '^4.25.0'",
    "preinstall": "git config --global url.\"https://${GITHUB_ACCESS_TOKEN}:@github.com/\".insteadof \"https://github.com/\"",
    "lint": "eslint --cache --config eslint.config.mjs src",
    "lint:fix": "npm run lint -- --fix",
    "security:audit": "audit-ci --moderate --report"
  },
  "keywords": [
    "zimlet",
    "ZimbraX",
    "Zimbra"
  ],
  "author": "",
  "devDependencies": {
    "@zimbra/eslint-config": "^3.0.0",
    "eslint": "^9.39.4",
    "@zimbra/zimlet-cli": "^19.0.0",
    "audit-ci": "^6.1.0"
  },
  "dependencies": {
    "@zimbra/x-ui": "^13.2.0",
    "@zimbra/oauth-client": "git+ssh://git@github.com/Zimbra/zm-x-oauth-client.git#2.0.0",
    "ajv": "^8.0.0"
  },
  "overrides": {
    "@eslint/eslintrc": {
      "ajv": "^6.12.6"
    }
  }
}
